# Optional: signing in by an emailed link, and opt-in play logs, through Supabase.
# Copy this file to .env (next to it, at the repo root) and fill in the key. Leave either value empty to
# build the game without them: it plays exactly the same.
# Everything here ends up in the game's code, which anyone can read: only the project's address and its
# public key belong here, never a service role key.

# The project's address.
VITE_SUPABASE_URL=https://kzexzqtmmvrbzofegggs.supabase.co

# The project's public key: Project Settings → API Keys, the "anon" (public) key, or the publishable key.
VITE_SUPABASE_ANON_KEY=
