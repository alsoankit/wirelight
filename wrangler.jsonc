// Cloudflare deploy config. The game is a static site: Cloudflare serves apps/web/dist as Worker
// static assets. Any path that isn't a file (e.g. /floor/0/room/<id>) gets index.html, so deep
// links work. The Worker's name must match the project in the Cloudflare dashboard.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wirelight",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./apps/web/dist",
    "not_found_handling": "single-page-application"
  }
}
