{
  "name": "wirelight",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @wirelight/web dev",
    "build": "pnpm --filter @wirelight/web build",
    "test": "vitest run --project sim --project shell --project rooms --project engine --project web && pnpm rooms:sightlines",
    "rooms:sightlines": "node tools/rooms/sightlines.mjs",
    "check": "biome check . && pnpm -r typecheck",
    "rooms:validate": "vitest run --project rooms",
    "e2e": "pnpm --filter @wirelight/web e2e",
    "difftest": "vitest run --project difftest",
    "audio:check": "AUDIO_LIST=1 vitest run --project audio",
    "voices:export": "VOICES_EXPORT=1 vitest run --project audio"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@types/node": "^26.6.4",
    "meshoptimizer": "1.2.0",
    "playwright-core": "^1.64.0",
    "sharp": "0.35.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
